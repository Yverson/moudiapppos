# Configuration d'exemple pour @apppos
# Copier ce fichier en .env.local et remplir avec vos valeurs

# ========== API Configuration ==========
# URL de base du backend MOUDI
# En développement: http://localhost:5000
# En production: https://api.moudi.com
VITE_API_URL=http://localhost:5000

# Nom de l'application affiché dans l'interface
VITE_APP_NAME=RestoPOS

# Activer ou désactiver l'analytique
VITE_ENABLE_ANALYTICS=false

# ========== Authentication ==========
# Token JWT d'authentification pour les appels API MOUDI
# Obtenir le token après login depuis le backend
# Format: Bearer token (sans le préfixe "Bearer ", ajouté automatiquement)
# Exemple: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0..."
# Si vide, utilise le token stocké dans localStorage après un login
VITE_AUTH_TOKEN=

# ========== Restaurant Configuration ==========
# ID unique du restaurant dans le système MOUDI
# Exemple: "rest_1", "rest_paris_downtown", etc.
# OBLIGATOIRE pour la synchronisation
VITE_RESTAURANT_ID=rest_1

# Nom du restaurant (affiché dans l'interface)
# Exemple: "Gourmet Burgers Downtown"
VITE_RESTAURANT_NAME=Gourmet Burgers Downtown

# Email du restaurant (utilisé pour les communications)
VITE_RESTAURANT_EMAIL=manager@gourmetburgers.com

# Numéro de téléphone du restaurant
VITE_RESTAURANT_PHONE=+1 (212) 555-0199

# Adresse du restaurant (affichée sur les reçus)
VITE_RESTAURANT_ADDRESS=123 Main Street, New York, NY 10001

# ========== Synchronization Settings ==========
# Activer la synchronisation automatique au démarrage de l'application
# true: Synchroniser automatiquement les catégories/menus au démarrage
# false: Nécessite une synchronisation manuelle
VITE_AUTO_SYNC_ON_STARTUP=true

# Fréquence de synchronisation automatique en heures
# 0: Désactiver la synchronisation automatique
# 24: Synchroniser chaque 24 heures
# 12: Synchroniser chaque 12 heures
# 1: Synchroniser chaque heure
VITE_AUTO_SYNC_INTERVAL=24

# ========== Advanced Settings (Optionnel) ==========
# Timeout pour les requêtes API (en millisecondes)
# VITE_API_TIMEOUT=30000

# Activer les logs détaillés de synchronisation
# VITE_DEBUG_SYNC=false

# Nombre maximum de tentatives de synchronisation avant abandon
# VITE_MAX_SYNC_RETRIES=3
